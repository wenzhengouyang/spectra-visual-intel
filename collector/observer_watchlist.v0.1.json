    "requires_personal_account": false,
    "allowed_access": ["publisher_rss", "public_atom", "official_blog", "official_github", "public_profile"],
    "forbidden_access": ["private_cookie", "credential_sharing", "login_bypass", "rate_limit_bypass"],
    "default_disposition": "p2_signal_only",
