# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
.coverage
.coverage.*
.pytest_cache/
.mypy_cache/
.ruff_cache/

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem
*.bak
*.orig
*.swp

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

/dist/
/.wrangler/
/outputs/
/work/
/.artifact-build/
/.pnpm-store/
/.venv-collector/
/.venv-llm/
/.venv-*/
/.hallmark/
/vendor/
/spectra_agent/runs/
/spectra_agent/.publish-remote/
/spectra_agent/logs/
/runtime/
/.runtime/
/data/
/integrations/we-mp-rss/
/collector/runs/*.json
/processor/runs/*.json
/verification/runs/
/verification/*.evidence.json
/verification/*.selection.json
/assets/editorial/*.png
/assets/editorial/story-auto-*.svg
/tmp/
/werss-wechat-qrcode.png

# Local model experiments and generated QA artifacts
/test-*.json
/test-*.log
/temp-*.json
/few-shot-*.json
/*.pre-sync-*.html
/.publish-remote/
/archive/

# Acquisition budgets and local review datasets are operational, not public assets.
**/acquisition-budget.sqlite*
**/*.budget.sqlite*
**/review-samples.sqlite*
**/evidence-sources/
